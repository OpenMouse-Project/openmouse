# OpenMouse-Support Discord bot configuration.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value here is a secret/server-side value — never expose these to a
# browser or prefix them with VITE_.

# Discord application/bot token (from the Discord Developer Portal).
DISCORD_TOKEN=

# Discord application client id and secret (used for OAuth2 staff login by the
# dashboard, shared with the bot's deployment).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The guild (server) where OpenMouse support runs.
DISCORD_GUILD_ID=
# The normal text channel that hosts the support panel (the #support-ticket channel).
SUPPORT_CHANNEL_ID=

# Supabase project URL (https://xxxx.supabase.co) and the service-role key.
# The service-role key bypasses RLS — keep it server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Discord user ids of staff allowed to act (whitelist).
STAFF_WHITELIST=
# Optional: a role id whose members are treated as staff, e.g. the @Support role.
STAFF_ROLE_ID=

# The invite URL to use in the ticket thread's "here's where support happens"
# summary (optional). Not required if the panel is already in the right server.
SUPPORT_INVITE_URL=

# Optional: after deploying the panel once, set this to that message id so the
# bot edits it on restart instead of stacking a new "Create Ticket" message.
# Find it by right-clicking the panel message > Copy Message ID (with dev mode).
SUPPORT_PANEL_MESSAGE_ID=
